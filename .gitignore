# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS
.DS_Store

# Build output
target/

# Local secrets -- never commit real API keys/credentials. .env.example (placeholders only) stays
# tracked; anything else matching .env* (a real .env, .env.local, etc) does not.
.env
.env.*
!.env.example
