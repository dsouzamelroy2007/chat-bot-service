# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS
.DS_Store

# Build output
target/

# Local secrets -- never commit real API keys/credentials. .env.example (placeholders only) stays
# tracked; anything else matching .env* (a real .env, .env.local, etc) does not.
.env
.env.*
!.env.example

# IDE-specific project files -- not portable across machines/editors, no reason to be shared.
.idea/
.vscode/

# Claude Code session state -- local to this machine, not part of the project.
.claude/

# Internal working dev-log kept locally for reference across sessions -- deliberately not part of
# this repo's public history; docs/ARCHITECTURE.md is the polished, public equivalent.
docs/PLAN.md
