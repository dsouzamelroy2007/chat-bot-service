# Copy to .env and fill in real values. Never commit .env.

# --- Free-tier LLM providers (Phase 1), tried in this priority order by ProviderRouter until one
# succeeds. Each is entirely optional -- an unset key just disables that one provider at startup
# (logged, not fatal). At least one should be set for the default profile to return real replies;
# with none set, every request falls through to the outer circuit breaker's canned 502 reply. See
# chatbot.providers in application.yml for base URLs, models, and daily quota limits. ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Tools (Phase 3), both optional/off-by-default -- weather and time need no key at all
# (Open-Meteo). See chatbot.tools in application.yml. ---
# Free tier (2,000 requests/day): https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
# Free tier (1,000 requests/month): https://app.tavily.com
TAVILY_API_KEY=

# --- Postgres (conversation memory store from Phase 2 onward; container required to boot
# the default profile from Phase 0 onward since spring-boot-starter-data-jpa is on the classpath) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=chatbot
# Host-side port docker-compose publishes Postgres on. Override if 5432 is already taken by
# another local service (e.g. a native Postgres install) -- only affects the host mapping, the
# app still talks to the postgres container on 5432 internally.
DB_HOST_PORT=5432

# --- Redis (hot-path cache / rate-limit store from Phase 1-2 onward; container required to
# boot the default profile from Phase 0 onward since spring-boot-starter-data-redis is on the
# classpath; Phase 1 also uses it for per-provider daily quota counters) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Host-side port docker-compose publishes Redis on, same override rationale as DB_HOST_PORT.
REDIS_HOST_PORT=6379
